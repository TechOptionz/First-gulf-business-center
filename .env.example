# Copy to .env.local (or .env) and fill in. Both are gitignored.
# The deployed site does NOT read these files -- set the same variables
# in the Vercel project settings.

# Resend API key. Server-side only: never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where enquiries are delivered.
# Point this at a personal test inbox first, and only switch it to the
# client's live address once you have confirmed delivery.
CONTACT_TO_EMAIL=you@example.com

# Visible senders. BOTH must sit on the domain verified in Resend, or the send
# is rejected. Optional: each defaults to the address shown if unset.
# Contact form:
# RESEND_FROM_EMAIL=First Gulf Business Center <no-reply@firstgulfbusiness.ae>
# Tour booking form:
# RESEND_BOOKING_FROM_EMAIL=First Gulf Business Center <bookings@firstgulfbusiness.ae>
